                "name": "domain_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter returned access code pools by name"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
