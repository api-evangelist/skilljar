{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skilljar Assets Domains > Course Series > Published Courses API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Domains > Course Series > Published Courses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "domains_course_series_published_courses_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/domains/:domain_name/course-series/:course_series_id/published-courses",
            "params": [
              {
                "name": "course_series_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve a paginated list of all published courses in the specified course series for this domain.\n\nEach published course includes its order in the series, course details, and related offers."
        }
      ]
    }
  ],
  "bundled": true
}