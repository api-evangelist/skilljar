{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skilljar Assets Ping API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Ping",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ping API",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/ping",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Ping the API endpoint.  HTTP 2xx responses indicate a successful authentication with the Skilljar API endpoint."
        }
      ]
    }
  ],
  "bundled": true
}