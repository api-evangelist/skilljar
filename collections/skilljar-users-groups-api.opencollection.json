                "description": "A page number within the paginated result set."
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "List groups for a user.\n\nReturns a list of all groups that the user is a member of."
