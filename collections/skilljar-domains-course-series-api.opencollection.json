{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skilljar Assets Domains > Course Series API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Domains > Course Series",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "domains_course_series_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/domains/:domain_name/course-series",
            "params": [
              {
                "name": "domain_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve a paginated list of all course series for the specified domain.\n\nEach course series includes metadata, associated offers, published paths, and published courses."
        },
        {
          "info": {
            "name": "domains_course_series_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/domains/:domain_name/course-series/:course_series_id",
            "params": [
              {
                "name": "course_series_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain_name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve detailed information for a specific course series within the domain.\n\nThe response includes metadata, offers, published paths, and the list of published courses in the series."
        }
      ]
    }
  ],
  "bundled": true
}