{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skilljar Assets tags API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "tags_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/tags",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "List Tags.  Returns a paginated list (1000 results per page) of Tags."
        },
        {
          "info": {
            "name": "tags_create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/tags",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Creates a new `Tag`."
        },
        {
          "info": {
            "name": "tags_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/tags/:tag_id",
            "params": [
              {
                "name": "tag_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get Tag details."
        },
        {
          "info": {
            "name": "tags_update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/tags/:tag_id",
            "params": [
              {
                "name": "tag_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Update Tag details. PUT and PATCH are identical - both do partial updates."
        },
        {
          "info": {
            "name": "tags_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/tags/:tag_id",
            "params": [
              {
                "name": "tag_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Update Tag details. PUT and PATCH are identical - both do partial updates."
        },
        {
          "info": {
            "name": "tags_destroy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/tags/:tag_id",
            "params": [
              {
                "name": "tag_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}