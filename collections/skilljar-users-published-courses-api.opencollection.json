{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skilljar Assets Users > Published Courses API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Users > Published Courses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "users_published_courses_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/users/:user_id/published-courses",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "List published courses with progress for a user.\n\nReturns a list of published courses in which the user is enrolled, including progress details.\nUses optimized batch enrollment loading to reduce database queries."
        },
        {
          "info": {
            "name": "users_published_courses_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/users/:user_id/published-courses/:published_course_id",
            "params": [
              {
                "name": "published_course_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve course progress for a user.\n\nReturns detailed progress information for a specific published course enrollment for the user."
        },
        {
          "info": {
            "name": "users_published_courses_update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/users/:user_id/published-courses/:published_course_id",
            "params": [
              {
                "name": "published_course_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Update course progress for a user.\n\nAllows updating the user's progress for a published course. Both PUT and PATCH perform partial updates.\nTo mark a course as complete, you only need to set the `completed_at` within the course progress."
        },
        {
          "info": {
            "name": "users_published_courses_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/users/:user_id/published-courses/:published_course_id",
            "params": [
              {
                "name": "published_course_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Partially update course progress for a user.\n\nAllows updating the user's progress for a published course. Both PUT and PATCH perform partial updates.\nTo mark a course as complete, you only need to set the `completed_at` within the course progress."
        }
      ]
    }
  ],
  "bundled": true
}